# All optional. Each unlocks one live section of the gallery.
# The site runs fine on the originals and imgflip templates with none of these set.

# Live "GIFs" section from Giphy. Free key: https://developers.giphy.com
GIPHY_API_KEY=

# Also feeds the "GIFs" section from Tenor. Free key from a Google Cloud project
# with the Tenor API enabled: https://console.cloud.google.com
TENOR_API_KEY=

# Live "Fresh" section: top image posts from meme subreddits.
# Create a "script" app at https://www.reddit.com/prefs/apps to get both values.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
